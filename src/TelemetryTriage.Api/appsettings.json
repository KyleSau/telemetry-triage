{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bus": { "Kind": "inmemory" },
  "Triage": { "Provider": "rules" },
  "Pipeline": {
    "Scenario": "correlated-fault",
    "IncidentGap": "00:00:10",
    "TriageConcurrency": 2
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "StreamName": "SYNTH-01",
    "ConsumerGroup": "telemetry-triage-api"
  },
  "Claude": {
    "Model": "claude-opus-5-5",
    "Effort": "medium"
  },
  "Observability": { "Exporter": "console" }
}
